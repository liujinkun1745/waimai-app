# ==========================================
# 环境变量配置（生产部署用）
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ==========================================

# MySQL 数据库
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DATABASE=waimai
DB_USERNAME=root
DB_PASSWORD=请修改为强密码

# JWT
JWT_SECRET=请修改为至少256位的随机字符串

# Redis
REDIS_HOST=localhost

# Elasticsearch
ES_URIS=http://localhost:9200

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USER=请修改
RABBITMQ_PASS=请修改为强密码

# MinIO 对象存储
MINIO_ROOT_USER=请修改
MINIO_ROOT_PASSWORD=请修改为强密码
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=请修改
MINIO_SECRET_KEY=请修改为强密码
MINIO_BUCKET=waimai-products
